# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Email administrateur de l'espace privé SEO
ADMIN_EMAIL="binchristophe2@gmail.com"

# ADMIN_PASSWORD: Mot de passe d'accès à l'espace administration privé (À configurer dans vos variables d'environnement)
ADMIN_PASSWORD="VOTRE_MOT_DE_PASSE_SECURISE_ICI"

# SESSION_SECRET: Clé secrète pour les sessions sécurisées (clé aléatoire 32 caractères)
SESSION_SECRET="generer_cle_secrete_aleatoire_32_caracteres"
